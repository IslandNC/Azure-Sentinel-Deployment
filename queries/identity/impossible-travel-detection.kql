// ============================================================
// Impossible Travel Detection
// ============================================================
// Purpose: Detect sign-ins from two different countries
//          within a 24-hour window for the same user.
//          Indicates potential account compromise or
//          credential sharing.
// MITRE:   T1078 - Valid Accounts
// Lookback: 24 hours
// Scheduled: Every 1 hour
// Severity: High
// Table:   SigninLogs (Entra ID)
// Note:    make_list(..., 2) captures the two most recent
//          sign-ins only. Users with 3+ sign-ins are evaluated
//          on their two most recent; earlier country changes
//          will not trigger this rule.
// ============================================================

SigninLogs
| where TimeGenerated > ago(24h)
| where ResultType == 0
| where isnotempty(UserPrincipalName)
| where isnotempty(IPAddress)
| extend
    Country    = tostring(LocationDetails.countryOrRegion),
    City       = tostring(LocationDetails.city),
    DeviceName = tostring(DeviceDetail.displayName),
    OS         = tostring(DeviceDetail.operatingSystem),
    Browser    = tostring(DeviceDetail.browser)
| where isnotempty(Country)
// Sort descending so make_list captures most-recent first
| sort by TimeGenerated desc
| summarize
    SigninHistory = make_list(
        pack(
            "Time",    TimeGenerated,
            "Country", Country,
            "City",    City,
            "IP",      IPAddress,
            "Device",  DeviceName,
            "OS",      OS,
            "Browser", Browser
        ),
        2
    )
    by UserPrincipalName
| where array_length(SigninHistory) == 2
| extend
    Previous = SigninHistory[1],
    Current  = SigninHistory[0]
| extend
    PreviousCountry = tostring(Previous.Country),
    PreviousCity    = tostring(Previous.City),
    PreviousIP      = tostring(Previous.IP),
    NewCountry      = tostring(Current.Country),
    NewCity         = tostring(Current.City),
    NewIP           = tostring(Current.IP),
    Device          = tostring(Current.Device),
    OS              = tostring(Current.OS),
    Browser         = tostring(Current.Browser),
    PreviousTime    = todatetime(Previous.Time),
    CurrentTime     = todatetime(Current.Time)
| where PreviousCountry != NewCountry
| project
    CurrentTime,
    UserPrincipalName,
    PreviousCountry,
    PreviousCity,
    PreviousIP,
    NewCountry,
    NewCity,
    NewIP,
    Device,
    OS,
    Browser,
    PreviousTime
| order by CurrentTime desc

// ============================================================
// Tuning Notes:
// - In single-user lab environments this returns 0 results
//   unless sign-ins occur from different geographic locations.
// - Add TimeDelta check for stricter impossible travel:
//   | extend TimeDelta = CurrentTime - PreviousTime
//   | where TimeDelta < 2h
// - Consider adding MFA status field for enrichment:
//   | extend MFAUsed = tostring(AuthenticationDetails[0].authenticationMethod)
// - Cross-reference NewIP with ThreatIntelligenceIndicator:
//   | join kind=leftouter (
//       ThreatIntelligenceIndicator
//       | where Active == true
//       | project TI_IP = NetworkIP, ThreatType
//     ) on $left.NewIP == $right.TI_IP
// ============================================================
